# Segredos do Hermes Agent — NUNCA commitar o arquivo .env.hermes real.

# ---- Modelo de IA (escolha um provedor; o wizard `hermes setup` também preenche isto)
ANTHROPIC_API_KEY=

# ---- Rocket.Chat (usuário-bot "hermes" → Minha Conta → Tokens de Acesso Pessoal)
ROCKETCHAT_USER_ID=
ROCKETCHAT_TOKEN=
ROCKETCHAT_HOME_CHANNEL=          # ID da sala #alertas
ROCKETCHAT_ALLOW_ALL_USERS=true   # todo mundo logado no chat pode usar o bot
ROCKETCHAT_REPLY_MODE=thread
ROCKETCHAT_REQUIRE_MENTION=true

# ---- Nekt (MCP) — token criado no painel da Nekt com escopo de leitura
NEKT_MCP_URL=
NEKT_MCP_TOKEN=
