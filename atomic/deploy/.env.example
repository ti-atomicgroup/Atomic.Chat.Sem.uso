# ---- Domínio / HTTPS
CHAT_DOMAIN=chat.atomicgroup.com.br
ACME_EMAIL=tools@atomicgroup.com.br

# ---- Imagem do Rocket.Chat (gerada pelo workflow .github/workflows/atomic-build.yml)
RC_IMAGE=ghcr.io/atomicgroup/atomic-chat
RC_TAG=8.9.1-atomic.1
SITE_NAME=Atomic Chat

# ---- Admin criado na primeira subida (troque a senha depois do 1º login)
RC_ADMIN_USERNAME=admin
RC_ADMIN_EMAIL=tools@atomicgroup.com.br
RC_ADMIN_PASS=troque-esta-senha

# ---- MongoDB (GB de cache do WiredTiger; ~25% da RAM da VPS)
MONGO_CACHE_GB=2

# ---- Hermes
HERMES_IMAGE=nousresearch/hermes-agent
HERMES_TAG=latest
